+import Foundation
+#if canImport(FoundationNetworking)
+@preconcurrency import FoundationNetworking
+#endif
+#if canImport(Combine)
+import Combine
+
+extension RestClient {
+    /// Executes a request and publishes its validated raw payload.
+    public func publisher(for request: RequestDefinition) -> AnyPublisher<ResponsePayload<Data>, RestingError> {
+        makePublisher {
+            try await self.execute(request)
+        }
+    }
+
+    /// Executes a request and publishes its raw response data.
+    public func dataPublisher(for request: RequestDefinition) -> AnyPublisher<Data, RestingError> {
+        makePublisher {
+            try await self.executeData(request)
+        }
+    }
+
+    /// Executes a request and publishes its decoded response value.
+    public func publisher<T: Decodable>(
+        for request: RequestDefinition,
+        as type: T.Type = T.self
+    ) -> AnyPublisher<T, RestingError> {
+        makePublisher {
+            try await self.execute(request, as: type)
+        }
+    }
+
+    private func makePublisher<Output>(
+        _ operation: @escaping () async throws -> Output
+    ) -> AnyPublisher<Output, RestingError> {
+        Deferred {
+            let subject = PassthroughSubject<Output, RestingError>()
+            let task = Task {
+                do {
+                    let output = try await operation()
+                    subject.send(output)
+                    subject.send(completion: .finished)
+                } catch {
+                    subject.send(completion: .failure(RestingError.map(error)))
+                }
+            }
+
+            return subject
+                .handleEvents(receiveCancel: { task.cancel() })
+                .eraseToAnyPublisher()
+        }
+        .eraseToAnyPublisher()
+    }
+}
+#endif
